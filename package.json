{
  "name": "launched",
  "private": true,
  "version": "26.0.2",
  "description": "Launcher Minecraft personnalisé",
  "author": "Infuseting",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vite.config.ts eslint.config.mjs --max-warnings 0",
    "format": "prettier --write src tests *.html *.json *.ts *.mjs README.md CONTRIBUTING.md .github/workflows/quality.yml",
    "format:check": "prettier --check src tests *.html *.json *.ts *.mjs README.md CONTRIBUTING.md .github/workflows/quality.yml",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.12.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "skinview3d": "^3.4.2",
    "tailwind-merge": "^3.5.0"
  }
}
